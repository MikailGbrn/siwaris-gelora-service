# SIWARIS GELORA Environment Variables Template
# Copy this file to a new file named '.env' and fill in your credentials.
# Do NOT commit '.env' to your version control.

# Port on which the Go backend runs (defaults to 8080)
PORT=8080

# Resend API Key for sending actual emails
RESEND_API_KEY=

# PostgreSQL database connection URL (Supabase Database Connection URI)
# If empty/unset, backend defaults to local SQLite database (siwaris.db)
DATABASE_URL=

# Supabase Storage project credentials for cloud file uploads
# If empty/unset, backend defaults to local folder uploads (/uploads)
SUPABASE_URL=
SUPABASE_KEY=
